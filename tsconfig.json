  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "legacy", "Pipeline Kopie 5", "01a05849-bf12-774d-8e7f-0b0c17933e1d", "01a05849-bf12-774d-8e7f-0b0c17933e1d 2", "01a0584a-6791-702d-a2c5-8ab6088b219d", "01a0584a-6791-702d-a2c5-8ab6088b219d 2"]
