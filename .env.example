# Bad & Energie Vertriebsmodul – Umgebungsvariablen (Kopie als .env.local)

# Öffentliche Basis-URL (https in Produktion)
APP_URL=http://localhost:3000

# Datenbank: Postgres (Neon pooled URL in Produktion) oder PGlite-Verzeichnis für lokale Entwicklung
DATABASE_URL=pglite://./data/pglite

# Vercel Blob (privater Store)
BLOB_READ_WRITE_TOKEN=

# Resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MAIL_FROM="Sabri Demir <info@bad-energie.de>"
# Lokal: Mails landen als .eml in ./data/outbox statt bei Resend
MAIL_TRANSPORT=file

# Sitzungen und Jobs (mindestens 32 Zeichen, z. B. openssl rand -base64 32)
SESSION_SECRET=
CRON_SECRET=

# Optionen
INTAKE_AI=off
# Lokales Chromium für die PDF-Vorschau in der Entwicklung (Produktion nutzt @sparticuz/chromium)
CHROME_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Auffangadresse (Vorführung, Tests): solange gesetzt, gehen ALLE Mails an diese Adresse,
# der echte Empfänger steht im Betreff. Für den Livebetrieb entfernen.
MAIL_TEST_TO=

# Nur von Werkzeugen gesetzt, nie von Hand: NODE_ENV setzt Next selbst (development, production, test).
# NODE_ENV=development
# SKIP_ENV_VALIDATION=1 schaltet die Prüfung in src/lib/env.ts vollständig ab; nur für Build-Werkzeuge, nie im Betrieb.
# SKIP_ENV_VALIDATION=
